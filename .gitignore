# ============================================================
#  .gitignore —— 分享本项目到 GitHub 时，这些文件不要上传
# ============================================================

# ------------------------------------------------------------
# ⛔ 凭据（最要紧！上传等于把自己的钥匙公开）
# ------------------------------------------------------------
# 证书目录：里面的 *.key 是私钥，泄露后别人能冒充你的服务端、
# 也能解开你所有隧道流量。绝不可上传。
certs/
**/certs/

# token 文件：内网穿透的共享密钥，等同于密码
tokens.txt
token.txt
**/tokens.txt
**/token.txt

# 兜底：任何位置的私钥 / 证书 / PEM 一律忽略
*.key
*.crt
*.pem
*.p12
*.pfx

# 客户端"连接包"（内含 ca.crt + tokens.txt）
*连接包*.zip

# 配置文件：里面常写着你的公网 IP、token 路径等
server.toml
client.toml
*.local.toml

# 运行期生成的数据（各自环境不同，不该进版本库）
# 注意：gitignore **不支持行内注释** —— "#" 必须独占一行，
#       否则注释会被当成模式的一部分，规则就静默失效了（这里踩过一次）。
# 过滤规则：可能含你内网服务的端口信息
rules.json
# IP 归属地缓存
geo-cache.json
# 客户端连接包
frp-连接包.zip

# ------------------------------------------------------------
# ⚠️ 构建产物（体积大 / 可重新生成，不必进版本库）
# ------------------------------------------------------------
build/
dist/
*.spec
version_info.txt

# ------------------------------------------------------------
# 鸿蒙工程（harmonyos/）—— 只忽略构建产物，源码与资源要保留
# ------------------------------------------------------------
# hvigor 依赖与本地缓存
harmonyos/**/oh_modules/
harmonyos/**/.hvigor/
harmonyos/**/hvigor/hvigor-config.json5.bak
harmonyos/.idea/
harmonyos/**/build/
harmonyos/**/.cxx/
harmonyos/local.properties
harmonyos/**/*.hap
harmonyos/**/*.hsp
harmonyos/**/*.har
harmonyos/**/*.app
# 签名相关（各自账号生成，绝不入库）
harmonyos/**/*.p12
harmonyos/**/*.cer
harmonyos/**/*.p7b

# ------------------------------------------------------------
# Python 缓存与虚拟环境
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------
# 日志与临时文件
# ------------------------------------------------------------
*.log
# 按天轮转出来的历史日志：app.log.2026-10-14 这种
*.log.[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]
logs/
*.tmp
*.bak
.dist_keep/

# 图标生成的临时预览（人工检查用，不必入库；
# 正式的 assets/icon.ico、icon.png、icon-1024.png、icon-source.jpg 要保留）
assets/_preview.png
assets/_check.png

# ------------------------------------------------------------
# 编辑器 / 操作系统
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
